<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="GM Fruits — Origen Quality Trust. Distribuição de frutas frescas de origem certificada para empresas e restauração." />
  <meta name="keywords" content="frutas frescas, distribuição alimentar, qualidade, GM Fruits, frutas origem, fornecedor frutas" />
  <meta name="author" content="GM Fruits" />
  <meta property="og:title" content="GM Fruits — Origen Quality Trust" />
  <meta property="og:description" content="Frutas frescas de origem certificada. Qualidade que se vê, confiança que se sente." />
  <meta property="og:type" content="website" />
  <title>GM Fruits — Origen Quality Trust</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,800;1,700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="css/style.css" />
</head>
<body>

  <!-- ===== HEADER ===== -->
  <header class="header" id="header">
    <div class="container header__inner">

      <a href="#inicio" class="header__logo">
        <div class="logo-mark">
          <span class="logo-mark__inner">GM</span>
        </div>
        <div class="logo-text-wrap">
          <span class="logo-name">GM Fruits</span>
          <span class="logo-tagline">Origen · Quality · Trust</span>
        </div>
      </a>

      <nav class="nav" id="nav">
        <ul class="nav__list">
          <li><a href="#inicio"       class="nav__link">Início</a></li>
          <li><a href="#sobre"        class="nav__link">Sobre</a></li>
          <li><a href="#produtos"     class="nav__link">Produtos</a></li>
          <li><a href="#qualidade"    class="nav__link">Qualidade</a></li>
          <li><a href="#contacto"     class="nav__link">Contacto</a></li>
        </ul>
      </nav>

      <a href="#contacto" class="btn btn--gradient header__cta">Pedir Orçamento</a>

      <button class="hamburger" id="hamburger" aria-label="Abrir menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <!-- ===== HERO ===== -->
  <section class="hero" id="inicio">
    <div class="hero__bg">
      <img
        src="https://images.unsplash.com/photo-1573246123716-6b1782bfc499?w=1600&q=80"
        alt="Frutas frescas de qualidade premium"
        class="hero__bg-img"
        loading="eager"
      />
      <div class="hero__overlay"></div>
    </div>

    <div class="container hero__inner">
      <div class="hero__content fade-in">
        <span class="hero__eyebrow">Origen · Quality · Trust</span>
        <h1 class="hero__title">
          A fruta que a natureza<br />
          <em>criou para si</em>
        </h1>
        <p class="hero__subtitle">
          Da origem ao destino, garantimos frutas frescas de qualidade superior —
          selecionadas com rigor, entregues com confiança.
        </p>
        <div class="hero__actions">
          <a href="#produtos"  class="btn btn--gradient btn--lg">Conhecer Produtos</a>
          <a href="#sobre"     class="btn btn--outline-white btn--lg">A Nossa História</a>
        </div>
      </div>

      <div class="hero__scroll-hint fade-in fade-in--slow">
        <span>Scroll</span>
        <div class="scroll-line"></div>
      </div>
    </div>
  </section>

  <!-- ===== VALORES (3 cards - Origen / Quality / Trust) ===== -->
  <section class="valores-band">
    <div class="container valores-band__grid">

      <div class="vcard reveal">
        <div class="vcard__icon vcard__icon--green">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="28" height="28"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/><path d="M12 6v6l4 2"/></svg>
        </div>
        <h3 class="vcard__title">Origen</h3>
        <p class="vcard__text">Rastreabilidade total e parcerias diretas com os melhores produtores.</p>
      </div>

      <div class="vcard reveal reveal--delay-1">
        <div class="vcard__icon vcard__icon--gold">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="28" height="28"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        </div>
        <h3 class="vcard__title">Quality</h3>
        <p class="vcard__text">Seleção rigorosa em cada etapa — só o melhor chega até si.</p>
      </div>

      <div class="vcard reveal reveal--delay-2">
        <div class="vcard__icon vcard__icon--orange">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="28" height="28"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <h3 class="vcard__title">Trust</h3>
        <p class="vcard__text">Parcerias duradouras assentes na transparência e fiabilidade.</p>
      </div>

    </div>
  </section>

  <!-- ===== SOBRE ===== -->
  <section class="sobre section" id="sobre">
    <div class="container sobre__grid">

      <div class="sobre__visual reveal">
        <img
          src="https://images.unsplash.com/photo-1615485500704-8e990f9900f7?w=700&q=80"
          alt="Seleção de frutas frescas"
          class="sobre__img"
          loading="lazy"
        />
        <div class="sobre__badge">
          <span class="sobre__badge-num">+15</span>
          <span class="sobre__badge-label">Anos de Experiência</span>
        </div>
      </div>

      <div class="sobre__content reveal reveal--right">
        <span class="section__tag">Quem Somos</span>
        <h2 class="section__title">Ligamos a melhor origem<br />às mesas que confiam em nós</h2>
        <p class="sobre__text">
          A <strong>GM Fruits</strong> nasceu da convicção de que fruta de qualidade começa
          na origem. Trabalhamos diretamente com produtores selecionados, garantindo que cada
          peça chega ao cliente no seu ponto ideal — fresca, saborosa e rastreável.
        </p>
        <p class="sobre__text">
          O nosso compromisso está expresso no nosso slogan:
          <em>Origen, Quality, Trust</em>. Não são apenas palavras — são os três pilares
          que guiam cada decisão que tomamos.
        </p>

        <div class="sobre__pillars">
          <div class="pillar">
            <span class="pillar__dot pillar__dot--green"></span>
            <div>
              <h4>Origem certificada</h4>
              <p>Rastreabilidade total do produtor ao cliente.</p>
            </div>
          </div>
          <div class="pillar">
            <span class="pillar__dot pillar__dot--gold"></span>
            <div>
              <h4>Controlo de qualidade</h4>
              <p>Seleção visual e organolética em cada lote.</p>
            </div>
          </div>
          <div class="pillar">
            <span class="pillar__dot pillar__dot--orange"></span>
            <div>
              <h4>Entrega de confiança</h4>
              <p>Logística rigorosa que preserva a frescura.</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ===== PRODUTOS ===== -->
  <section class="produtos section section--dark" id="produtos">
    <div class="container">
      <div class="section__header reveal">
        <span class="section__tag section__tag--light">Categorias</span>
        <h2 class="section__title section__title--light">O melhor de cada origem</h2>
        <p class="section__subtitle section__subtitle--light">
          Frutas e produtos selecionados dos melhores mercados nacionais e internacionais.
        </p>
      </div>

      <div class="produtos__grid">

        <div class="pcard reveal">
          <div class="pcard__img-wrap">
            <img src="https://images.unsplash.com/photo-1610832958506-aa56368176cf?w=500&q=75" alt="Frutas tropicais" loading="lazy" />
            <div class="pcard__overlay">
              <a href="#contacto" class="pcard__cta">Solicitar</a>
            </div>
          </div>
          <div class="pcard__info">
            <h3>Tropicais & Exóticas</h3>
            <p>Manga, papaia, maracujá e muito mais, na época certa.</p>
          </div>
        </div>

        <div class="pcard reveal reveal--delay-1">
          <div class="pcard__img-wrap">
            <img src="https://images.unsplash.com/photo-1528825871115-3581a5387919?w=500&q=75" alt="Citrinos" loading="lazy" />
            <div class="pcard__overlay">
              <a href="#contacto" class="pcard__cta">Solicitar</a>
            </div>
          </div>
          <div class="pcard__info">
            <h3>Citrinos</h3>
            <p>Laranjas, limões e tangerinas de origens premiadas.</p>
          </div>
        </div>

        <div class="pcard reveal reveal--delay-2">
          <div class="pcard__img-wrap">
            <img src="https://images.unsplash.com/photo-1568702846914-96b305d2aaeb?w=500&q=75" alt="Maçãs e peras" loading="lazy" />
            <div class="pcard__overlay">
              <a href="#contacto" class="pcard__cta">Solicitar</a>
            </div>
          </div>
          <div class="pcard__info">
            <h3>Pomóideas</h3>
            <p>Maçãs, peras e marmelos das melhores regiões.</p>
          </div>
        </div>

        <div class="pcard reveal reveal--delay-3">
          <div class="pcard__img-wrap">
            <img src="https://images.unsplash.com/photo-1553279768-865429fa0078?w=500&q=75" alt="Frutos vermelhos" loading="lazy" />
            <div class="pcard__overlay">
              <a href="#contacto" class="pcard__cta">Solicitar</a>
            </div>
          </div>
          <div class="pcard__info">
            <h3>Frutos Vermelhos</h3>
            <p>Morangos, framboesas e mirtilos de cultivo controlado.</p>
          </div>
        </div>

        <div class="pcard reveal">
          <div class="pcard__img-wrap">
            <img src="https://images.unsplash.com/photo-1537640538966-79f369143f8f?w=500&q=75" alt="Uvas e frutos secos" loading="lazy" />
            <div class="pcard__overlay">
              <a href="#contacto" class="pcard__cta">Solicitar</a>
            </div>
          </div>
          <div class="pcard__info">
            <h3>Uvas</h3>
            <p>Variedades de mesa premium, nacionais e importadas.</p>
          </div>
        </div>

        <div class="pcard reveal reveal--delay-1">
          <div class="pcard__img-wrap">
            <img src="https://images.unsplash.com/photo-1571771894821-ce9b6c11b08e?w=500&q=75" alt="Frutas de caroço" loading="lazy" />
            <div class="pcard__overlay">
              <a href="#contacto" class="pcard__cta">Solicitar</a>
            </div>
          </div>
          <div class="pcard__info">
            <h3>Frutos de Caroço</h3>
            <p>Pêssegos, nectarinas e ameixas na época ideal.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ===== NÚMEROS ===== -->
  <section class="numeros section" id="numeros">
    <div class="container">
      <div class="numeros__grid">
        <div class="stat reveal">
          <span class="stat__value" data-target="15">0</span>
          <span class="stat__suffix">+</span>
          <p class="stat__label">Anos de experiência</p>
        </div>
        <div class="stat reveal reveal--delay-1">
          <span class="stat__value" data-target="20">0</span>
          <span class="stat__suffix">+</span>
          <p class="stat__label">Países de origem</p>
        </div>
        <div class="stat reveal reveal--delay-2">
          <span class="stat__value" data-target="300">0</span>
          <span class="stat__suffix">t+</span>
          <p class="stat__label">Distribuídas por ano</p>
        </div>
        <div class="stat reveal reveal--delay-3">
          <span class="stat__value" data-target="500">0</span>
          <span class="stat__suffix">+</span>
          <p class="stat__label">Clientes satisfeitos</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== QUALIDADE / SUSTENTABILIDADE ===== -->
  <section class="qualidade section section--light" id="qualidade">
    <div class="container">
      <div class="section__header reveal">
        <span class="section__tag">Qualidade &amp; Sustentabilidade</span>
        <h2 class="section__title">O nosso compromisso<br />vai além da fruta</h2>
      </div>

      <div class="qualidade__grid">
        <div class="qcard reveal">
          <div class="qcard__icon">🌿</div>
          <h4 class="qcard__title">Práticas Sustentáveis</h4>
          <p class="qcard__text">Trabalhamos com produtores que respeitam o ambiente e aplicam agriculturas integradas ou biológicas.</p>
        </div>
        <div class="qcard reveal reveal--delay-1">
          <div class="qcard__icon">🔬</div>
          <h4 class="qcard__title">Controlo Analítico</h4>
          <p class="qcard__text">Análises regulares a resíduos e contaminantes garantem conformidade com as normas europeias mais exigentes.</p>
        </div>
        <div class="qcard reveal reveal--delay-2">
          <div class="qcard__icon">❄️</div>
          <h4 class="qcard__title">Cadeia de Frio</h4>
          <p class="qcard__text">Logística refrigerada do produtor ao cliente, preservando a frescura e os nutrientes em cada entrega.</p>
        </div>
        <div class="qcard reveal reveal--delay-3">
          <div class="qcard__icon">📋</div>
          <h4 class="qcard__title">Certificações</h4>
          <p class="qcard__text">Trabalhamos com fornecedores certificados GlobalG.A.P., BRC, IFS e outros standards reconhecidos internacionalmente.</p>
        </div>
      </div>

      <div class="certs reveal">
        <p class="certs__label">Certificações dos nossos parceiros</p>
        <div class="certs__logos">
          <div class="cert-badge">GlobalG.A.P.</div>
          <div class="cert-badge">BRC Food</div>
          <div class="cert-badge">IFS Food</div>
          <div class="cert-badge">ISO 22000</div>
          <div class="cert-badge">Rainforest Alliance</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CONTACTO ===== -->
  <section class="contacto section" id="contacto">
    <div class="container">
      <div class="section__header reveal">
        <span class="section__tag">Contacto</span>
        <h2 class="section__title">Vamos crescer juntos?</h2>
        <p class="section__subtitle">Preencha o formulário e a nossa equipa responde em menos de 24 horas.</p>
      </div>

      <div class="contacto__grid">

        <form class="form reveal" id="contactForm" novalidate>
          <div class="form__row">
            <div class="form__group">
              <label class="form__label" for="nome">Nome *</label>
              <input class="form__input" type="text" id="nome" name="nome" placeholder="O seu nome" required />
              <span class="form__error" id="nome-error"></span>
            </div>
            <div class="form__group">
              <label class="form__label" for="empresa">Empresa</label>
              <input class="form__input" type="text" id="empresa" name="empresa" placeholder="Nome da empresa" />
            </div>
          </div>
          <div class="form__row">
            <div class="form__group">
              <label class="form__label" for="email">Email *</label>
              <input class="form__input" type="email" id="email" name="email" placeholder="email@empresa.com" required />
              <span class="form__error" id="email-error"></span>
            </div>
            <div class="form__group">
              <label class="form__label" for="telefone">Telefone</label>
              <input class="form__input" type="tel" id="telefone" name="telefone" placeholder="+351 900 000 000" />
            </div>
          </div>
          <div class="form__group">
            <label class="form__label" for="mensagem">Mensagem *</label>
            <textarea class="form__input form__textarea" id="mensagem" name="mensagem" placeholder="Como podemos ajudar? Descreva as suas necessidades…" required></textarea>
            <span class="form__error" id="mensagem-error"></span>
          </div>
          <button type="submit" class="btn btn--gradient btn--full">Enviar Mensagem</button>
          <p class="form__success" id="formSuccess">✅ Mensagem enviada! Entraremos em contacto brevemente.</p>
        </form>

        <div class="contacto__info reveal reveal--right">
          <div class="info-item">
            <span class="info-item__icon">📍</span>
            <div>
              <h4>Morada</h4>
              <p>
                Edf. Toma Café<br />
                Parque Empresarial da Cancela<br />
                MI 3.3 — Caniço<br />
                9125-042 Santa Cruz, Madeira
              </p>
            </div>
          </div>
          <div class="info-item">
            <span class="info-item__icon">📞</span>
            <div>
              <h4>Telefone</h4>
              <p><a href="tel:+351291091576">(+351) 291 091 576</a></p>
            </div>
          </div>
          <div class="info-item">
            <span class="info-item__icon">✉️</span>
            <div>
              <h4>Email</h4>
              <p><a href="mailto:info@gmfruits.com">info@gmfruits.com</a></p>
            </div>
          </div>
          <div class="info-item">
            <span class="info-item__icon">🕐</span>
            <div>
              <h4>Horário</h4>
              <p>Seg–Sex: 07:00 – 18:00<br />Sáb: 07:00 – 13:00</p>
            </div>
          </div>

          <div class="mapa">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3547.5!2d-16.8295!3d32.6648!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xc6060a0!2sCani%C3%A7o%2C+Santa+Cruz%2C+Madeira!5e0!3m2!1spt!2spt!4v1700000000000"
              width="100%" height="230"
              style="border:0; border-radius:12px;"
              allowfullscreen="" loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Localização GM Fruits"
            ></iframe>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ===== FOOTER ===== -->
  <footer class="footer">
    <div class="container footer__inner">

      <div class="footer__brand">
        <a href="#inicio" class="footer__logo">
          <div class="logo-mark logo-mark--sm">
            <span class="logo-mark__inner">GM</span>
          </div>
          <div class="logo-text-wrap">
            <span class="logo-name logo-name--light">GM Fruits</span>
            <span class="logo-tagline logo-tagline--light">Origen · Quality · Trust</span>
          </div>
        </a>
        <p class="footer__desc">
          Da origem à sua mesa — frutas frescas de qualidade
          superior, entregues com confiança.
        </p>
        <div class="footer__social">
          <a href="#" aria-label="Facebook" class="social-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href="#" aria-label="Instagram" class="social-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
          </a>
          <a href="#" aria-label="LinkedIn" class="social-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
        </div>
      </div>

      <div class="footer__links">
        <h5>Empresa</h5>
        <ul>
          <li><a href="#sobre">Sobre nós</a></li>
          <li><a href="#qualidade">Qualidade</a></li>
          <li><a href="#numeros">Em números</a></li>
          <li><a href="#contacto">Contacto</a></li>
        </ul>
      </div>

      <div class="footer__links">
        <h5>Produtos</h5>
        <ul>
          <li><a href="#produtos">Tropicais &amp; Exóticas</a></li>
          <li><a href="#produtos">Citrinos</a></li>
          <li><a href="#produtos">Frutos Vermelhos</a></li>
          <li><a href="#produtos">Frutos de Caroço</a></li>
        </ul>
      </div>

      <div class="footer__links">
        <h5>Legal</h5>
        <ul>
          <li><a href="#">Política de Privacidade</a></li>
          <li><a href="#">Termos e Condições</a></li>
          <li><a href="#">Política de Cookies</a></li>
        </ul>
      </div>

    </div>

    <div class="footer__bottom">
      <div class="container">
        <p>© <span id="year"></span> GM Fruits. Todos os direitos reservados.</p>
      </div>
    </div>
  </footer>

  <!-- Botão voltar ao topo -->
  <button class="back-to-top" id="backToTop" aria-label="Voltar ao topo">↑</button>

  <script src="js/script.js"></script>
</body>
</html>
